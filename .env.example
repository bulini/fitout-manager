# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server (cron reminder). NON esporla mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# URL pubblico dell'app (usato nei link dentro email/Telegram)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron: segreto che protegge /api/cron/reminders ---
CRON_SECRET=cambia-questo-valore

# --- Web Push (genera con: npm run vapid) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@boxyland.it

# --- Email (Resend, https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM="Boxyland Manager <reminder@tuodominio.it>"

# --- Telegram (crea un bot con @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- AI (da decidere: "none" | "anthropic" | "openai") ---
AI_PROVIDER=none
AI_API_KEY=
